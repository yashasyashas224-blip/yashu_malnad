{
  "name": "mce-navigator-backend",
  "version": "1.0.0",
  "description": "Backend API Server for MCE Hassan Campus Navigator",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "test": "npm run test:all",
    "test:way1": "tsx ../tests/runAllTests.ts",
    "test:way2": "tsx ../tests/testLiveApi.ts",
    "test:way3": "tsx ../tests/testFrontendBuild.ts",
    "test:all": "tsx ../tests/runAllTests.ts && tsx ../tests/testLiveApi.ts && tsx ../tests/testFrontendBuild.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
